NODE_ENV=development
PORT=10000

# ---------------------------------------------------------------------------
# Origins
# ---------------------------------------------------------------------------
# Browser origins allowed for CORS + Socket.IO. Never '*'. Comma-separated.
# In production this MUST list your deployed frontend (Vercel) URL exactly.
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Required in production. Without it the server uses a non-persistent in-memory
# store (development only - all users, rooms, games and audit logs are lost on
# restart). Use a MongoDB Atlas connection string.
MONGODB_URI=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# >= 32 characters, required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Admin bootstrap (one-time, see docs/DEPLOYMENT.md)
# ---------------------------------------------------------------------------
# Used ONLY by `npm run create-admin -w backend`. It is read from the environment
# on purpose so the first administrator password never appears in shell history,
# the process list, or a committed file. Unset it after use.
# Must be >= 12 chars with an upper case, a lower case and a digit.
ADMIN_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Optional: run the MongoStore contract tests against a DISPOSABLE database.
# Without it the 10 MongoDB tests are skipped (never silently passed).
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/oldmaid_test