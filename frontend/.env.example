# ---------------------------------------------------------------------------
# Leave both EMPTY in development: the Vite dev proxy forwards /api, /health
# and /socket.io to http://localhost:10000 (see vite.config.ts).
# ---------------------------------------------------------------------------
# In production (Vercel) set both to the PERSISTENT Node backend (Render /
# Railway / any long-lived host). Do NOT point them at a Vercel serverless
# function: Socket.IO needs one long-lived process and will not work there.
#
# These values are baked into the client bundle at build time and are PUBLIC.
# Never put an admin token, a database URL or any other secret here.
# ---------------------------------------------------------------------------
VITE_API_URL=
VITE_SOCKET_URL=

# Optional: override the dev proxy target (defaults to http://localhost:10000).
# VITE_DEV_BACKEND=http://localhost:10000